{
  "schemaVersion": 1,
  "id": "wowkeybindhelper",
  "version": "${version}",
  "name": "WoW Keybind Helper",
  "description": "A live bar of key prompts under the inventory for the World of Wynncraft modpack.",
  "authors": ["DrBiznes"],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": ["me.jamino.wowkeybindhelper.WowKeybindHelper"],
    "modmenu": ["me.jamino.wowkeybindhelper.config.ModMenuIntegration"]
  },
  "mixins": ["wowkeybindhelper.mixins.json"],
  "depends": {
    "java": ">=21",
    "minecraft": ">=${minecraft_version}",
    "fabric-api": "*",
    "fabricloader": ">=0.18.0"
  },
  "suggests": {
    "wynntils": "*",
    "cloth-config2": "*",
    "modmenu": "*",
    "classkeybindprofiles": "*"
  }
}
